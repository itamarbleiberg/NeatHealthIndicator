# ...but the Gradle wrapper jar must be committed, or ./gradlew cannot bootstrap.
!gradle/wrapper/gradle-wrapper.jar

# Published builds are committed deliberately so the mod can be downloaded without a GitHub login.
!dist/*.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

